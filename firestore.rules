rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "jcavitellihs@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Validators ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'turns', 'totalTurns', 'role']) &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.email is string &&
             data.turns is number &&
             data.totalTurns is number &&
             data.role in ['admin', 'client'];
    }

    function isValidReward(data) {
      return data.keys().hasAll(['name', 'requiredTurns', 'type']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.requiredTurns is number && data.requiredTurns > 0 &&
             data.type in ['descuento', 'servicio', 'producto'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['type', 'amount', 'createdAt']) &&
             data.type in ['sum', 'subtract', 'redeem'] &&
             data.amount is number &&
             (!('userId' in data) || data.userId is string) &&
             (!('userName' in data) || data.userName is string) &&
             (!('realized' in data) || data.realized is bool);
    }

    // --- Rules ---

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == 'client' || isAdmin() || request.auth.token.email == "jcavitellihs@gmail.com");
      allow update: if isAuthenticated() && (
        isAdmin() || 
        request.auth.token.email == "jcavitellihs@gmail.com" ||
        (isOwner(userId) && request.resource.data.role == resource.data.role && isValidUser(request.resource.data))
      );
      allow delete: if isAdmin() || request.auth.token.email == "jcavitellihs@gmail.com";

      match /history/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isAdmin() || isOwner(userId)) && isValidTransaction(request.resource.data);
        allow update: if isAdmin() && isValidTransaction(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    match /{path=**}/history/{transactionId} {
      allow read: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow create, update: if (isAdmin() || (isAuthenticated() && request.auth.token.email == "jcavitellihs@gmail.com")) && isValidReward(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.token.email == "jcavitellihs@gmail.com");
    }

    match /stats/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
